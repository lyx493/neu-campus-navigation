<view class="tabbar-shell">
  <view class="tabbar">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon-wrap">
        <text class="tab-icon">{{item.icon}}</text>
      </view>
      <text class="tab-label">{{item.text}}</text>
      <view class="active-dot"></view>
    </view>
  </view>
</view>