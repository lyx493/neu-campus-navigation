.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 0 22rpx calc(12rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 247, 251, 0), rgba(245, 247, 251, 0.96) 36%);
}

.tabbar {
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 1rpx solid rgba(31, 60, 103, 0.08);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 14rpx 42rpx rgba(31, 60, 103, 0.14);
}

.tab-item {
  position: relative;
  width: 120rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8d99aa;
}

.tab-icon-wrap {
  width: 46rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
}

.tab-icon {
  font-size: 30rpx;
  line-height: 1;
  font-weight: 700;
}

.tab-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.active {
  color: #1e66e8;
}

.active .tab-icon-wrap {
  background: #e9f0ff;
}

.active-dot {
  position: absolute;
  bottom: 8rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #1e66e8;
  opacity: 0;
}

.active .active-dot {
  opacity: 1;
}