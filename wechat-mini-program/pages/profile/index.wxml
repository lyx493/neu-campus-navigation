<view class="page profile-page">
  <view class="status-spacer"></view>
  <view class="profile-hero">
    <view class="hero-orb orb-a"></view><view class="hero-orb orb-b"></view>
    <view class="profile-top"><text class="profile-title">我的</text><text class="profile-chip">东北大学</text></view>
    <view class="user-row">
      <view class="avatar">林</view>
      <view class="user-copy"><text class="user-name">{{user.nickname}}</text><text class="user-meta">{{user.college}} · {{user.grade}}</text></view>
      <view class="edit-btn" data-text="个人资料编辑即将开放" bindtap="showTip">编辑</view>
    </view>
  </view>
  <view class="stats-card">
    <view class="stat-item"><text class="stat-number">{{routeCount}}</text><text class="stat-label">导航次数</text></view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="openFavorites"><text class="stat-number">{{favoriteCount}}</text><text class="stat-label">收藏地点</text></view>
    <view class="stat-divider"></view>
    <view class="stat-item"><text class="stat-number">{{visitedCount}}</text><text class="stat-label">已到访</text></view>
  </view>
  <view class="campus-card" bindtap="openCampus">
    <view class="campus-mark">NEU</view>
    <view class="campus-copy"><text class="campus-name">{{campus.name}}</text><text class="campus-address">{{campus.address}}</text></view>
    <text class="campus-arrow">↗</text>
  </view>
  <view class="menu-card">
    <view class="menu-item" bindtap="openFavorites"><view class="menu-icon heart">♡</view><text>我的收藏</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" data-text="校园卡功能即将开放" bindtap="showTip"><view class="menu-icon card">▣</view><text>校园卡</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" data-text="已记录你的最近到访地点" bindtap="showTip"><view class="menu-icon history">◷</view><text>最近到访</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="showAbout"><view class="menu-icon info">i</view><text>关于校园导航</text><text class="menu-arrow">›</text></view>
  </view>
  <view wx:if="{{recent.length}}" class="profile-recent">
    <view class="section-head"><text class="section-title">最近到访</text></view>
    <view class="mini-places"><view wx:for="{{recent}}" wx:key="id" class="mini-place"><view style="background:{{item.softColor}};color:{{item.color}};" class="mini-place-icon">{{item.emoji}}</view><text>{{item.shortName}}</text></view></view>
  </view>
</view>