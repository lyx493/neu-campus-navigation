.profile-page { padding: 0 26rpx calc(160rpx + env(safe-area-inset-bottom)); background: #f5f7fb; }
.profile-hero { position: relative; height: 330rpx; padding: 20rpx 26rpx; border-radius: 36rpx; overflow: hidden; background: linear-gradient(135deg,#1b56cf,#1e7af0); box-shadow: 0 18rpx 42rpx rgba(30,102,232,.24); }
.hero-orb { position: absolute; border-radius: 50%; background: rgba(255,255,255,.11); }
.orb-a { width: 260rpx; height: 260rpx; right: -70rpx; top: -80rpx; }
.orb-b { width: 150rpx; height: 150rpx; left: -55rpx; bottom: -70rpx; }
.profile-top { position: relative; display: flex; align-items: center; justify-content: space-between; }
.profile-title { font-size: 38rpx; font-weight: 800; color: #fff; }
.profile-chip { height: 42rpx; padding: 0 16rpx; border-radius: 21rpx; display: flex; align-items: center; background: rgba(255,255,255,.16); color: #e9f1ff; font-size: 18rpx; }
.user-row { position: relative; margin-top: 48rpx; display: flex; align-items: center; }
.avatar { width: 104rpx; height: 104rpx; border-radius: 34rpx; display: flex; align-items: center; justify-content: center; background: #fff; color: #1e66e8; font-size: 39rpx; font-weight: 850; box-shadow: 0 10rpx 28rpx rgba(8,30,80,.18); }
.user-copy { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.user-name { font-size: 35rpx; font-weight: 800; color: #fff; }
.user-meta { margin-top: 8rpx; font-size: 21rpx; color: #cbdafa; }
.edit-btn { height: 54rpx; padding: 0 18rpx; border-radius: 18rpx; display: flex; align-items: center; background: rgba(255,255,255,.17); color: #fff; font-size: 20rpx; }
.stats-card { position: relative; z-index: 2; margin: -34rpx 18rpx 0; padding: 24rpx 10rpx; border-radius: 28rpx; display: flex; align-items: center; background: #fff; box-shadow: 0 12rpx 32rpx rgba(31,60,103,.1); }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-number { font-size: 34rpx; font-weight: 820; color: #1c324e; }
.stat-label { margin-top: 6rpx; font-size: 19rpx; color: #8b98aa; }
.stat-divider { width: 1rpx; height: 46rpx; background: #edf0f5; }
.campus-card { margin-top: 24rpx; padding: 20rpx; border-radius: 27rpx; display: flex; align-items: center; background: #fff; border: 1rpx solid rgba(31,60,103,.05); box-shadow: 0 8rpx 24rpx rgba(31,60,103,.05); }
.campus-mark { width: 68rpx; height: 68rpx; border-radius: 21rpx; display: flex; align-items: center; justify-content: center; background: #e9f0ff; color: #1e66e8; font-size: 18rpx; font-weight: 850; }
.campus-copy { flex: 1; min-width: 0; margin-left: 16rpx; display: flex; flex-direction: column; }
.campus-name { font-size: 25rpx; font-weight: 750; color: #20354f; }
.campus-address { margin-top: 6rpx; font-size: 19rpx; color: #8c99aa; }
.campus-arrow { font-size: 28rpx; color: #1e66e8; }
.menu-card { margin-top: 24rpx; padding: 4rpx 20rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 9rpx 26rpx rgba(31,60,103,.05); }
.menu-item { min-height: 96rpx; display: flex; align-items: center; border-bottom: 1rpx solid #f0f3f7; font-size: 24rpx; font-weight: 650; color: #293e58; }
.menu-item:last-child { border-bottom: 0; }
.menu-icon { width: 54rpx; height: 54rpx; margin-right: 16rpx; border-radius: 17rpx; display: flex; align-items: center; justify-content: center; background: #edf3ff; color: #1e66e8; font-size: 25rpx; font-weight: 750; }
.menu-icon.card { background: #eef8f2; color: #1b9765; }
.menu-icon.history { background: #fff4e9; color: #d27b35; }
.menu-icon.info { background: #f3effc; color: #7658c7; }
.menu-arrow { margin-left: auto; color: #b8c1ce; font-size: 34rpx; }
.profile-recent { margin-top: 32rpx; }
.mini-places { display: flex; gap: 12rpx; }
.mini-place { flex: 1; padding: 18rpx 10rpx; border-radius: 24rpx; display: flex; flex-direction: column; align-items: center; background: #fff; color: #425871; font-size: 20rpx; }
.mini-place-icon { width: 58rpx; height: 58rpx; margin-bottom: 10rpx; border-radius: 19rpx; display: flex; align-items: center; justify-content: center; font-size: 25rpx; }